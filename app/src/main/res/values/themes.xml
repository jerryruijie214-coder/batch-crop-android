<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BatchCrop" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>

        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorSurfaceVariant">@color/brand_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/brand_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/brand_surface</item>
        <item name="colorSurfaceContainerHighest">@color/brand_surface_variant</item>

        <item name="colorOutline">@color/brand_outline</item>
        <item name="colorOutlineVariant">@color/brand_outline_variant</item>

        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorOnBackground">@color/brand_on_background</item>

        <item name="colorError">@color/brand_error</item>
        <item name="colorOnError">@color/brand_on_error</item>

        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.BatchCrop.Crop" parent="Theme.BatchCrop">
        <item name="android:windowBackground">@color/crop_background</item>
        <item name="colorSurface">@color/crop_surface</item>
        <item name="colorOnSurface">@color/crop_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/crop_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/crop_surface</item>
        <item name="colorSurfaceContainerLow">@color/crop_surface</item>
        <item name="colorSurfaceContainerHighest">@color/crop_surface</item>
    </style>

    <style name="Widget.BatchCrop.RegionChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
    </style>

    <style name="Widget.BatchCrop.StepperButton" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="ShapeAppearance.BatchCrop.Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

</resources>
