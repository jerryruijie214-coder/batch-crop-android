<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/brand_surface_variant"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.BatchCrop.Thumb" />

    <ImageButton
        android:id="@+id/removeBtn"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_margin="5dp"
        android:background="@drawable/bg_circle_scrim"
        android:contentDescription="@string/clear_all"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb"
        app:tint="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
